APP_NAME="Task API"
DEBUG=true

# Used when running the application directly from the host machine.
# Docker Compose overrides the hostname with the `postgres` service name.
DATABASE_URL=postgresql+psycopg://task_api:change_this_password@localhost:5432/task_api

# Change this to a long, random value before deploying.
SECRET_KEY=replace_with_a_long_random_secret

POSTGRES_DB=task_api
POSTGRES_USER=task_api
POSTGRES_PASSWORD=change_this_password

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
LOGIN_RATE_LIMIT=5/minute
